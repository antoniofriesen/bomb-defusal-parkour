# Image configuration
IMAGE_PREFIX=antoniofriesen
IMAGE_TAG=latest

# External MQTT Broker (runs on separate Raspberry Pi)
MQTT_BROKER_HOST=192.168.50.1
MQTT_BROKER_PORT=1883
MQTT_BROKER_USERNAME=pi_user
MQTT_BROKER_PASSWORD=group-1

# Port mappings
DASHBOARD_BACKEND_PORT=5175
DASHBOARD_FRONTEND_PORT=5173
SCOREBOARD_BACKEND_PORT=8001
SCOREBOARD_FRONTEND_PORT=8002
